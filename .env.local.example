# Optional: enables full AI answers. Without it CampusAI runs in offline mode.
# Free keys: Groq (gsk_..., https://console.groq.com/keys) or Gemini (AIza..., https://aistudio.google.com/apikey).
# OpenAI keys work too. The provider is detected from the key.
AI_API_KEY=
# Optional overrides
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1

# Database + file storage (Supabase). Required for deployment (e.g. Vercel); without them the app uses
# data/db.json, data/user-data.json and data/uploads/ on local disk.
# SUPABASE_DB_URL: Supabase -> Connect -> "Transaction pooler" (port 6543) or "Session pooler" URI, with your DB password.
# Tables are created automatically on first request, with row-level security on and no policies,
# so they can't be read through Supabase's public REST API.
SUPABASE_DB_URL=
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API. Server-only; never expose the service role key.
# A private "course-files" bucket is created automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=course-files

# Auth (optional). Defaults: a random secret stored in the database, and admin@campusai.edu / admin12345.
# Set ADMIN_PASSWORD before the first deploy so the seeded admin doesn't use the default password.
# AUTH_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
